# Copia este archivo como .env y completa los valores reales.
# Nunca subas tu .env a Git.

MONGO_URL=tu_cadena_de_conexion_de_mongodb
MONGO_DB=sistema_setup
PORT=3000

# Clave larga y aleatoria para firmar los tokens de sesión.
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esta_clave_por_una_larga_y_segura
JWT_EXPIRA=7d

# Opcional: URL del frontend en producción (si se despliega por separado).
# Ejemplo: https://mi-pagina.vercel.app
FRONTEND_URL=

# Chatbot con IA local mediante Ollama.
# Instalá Ollama, iniciá el servicio y descargá el modelo con:
# ollama pull llama3.2:3b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_MS=90000
